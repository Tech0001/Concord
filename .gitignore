# Dependencies
node_modules/
venv/
venv-parakeet/

# Build output
dist/
server/public/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Replit (workspace-specific)
.replit
replit.nix

# Vite cache
vite.config.ts.*

# Working folders (transient content)
temp/
downloads/
transcripts/
