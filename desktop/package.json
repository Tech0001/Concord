{
  "name": "concord-next",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "bash ../scripts/package-next-linux.sh",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ts": "node --test \"src/**/*.test.ts\"",
    "screens": "node scripts/screens.mjs",
    "test:player": "node scripts/player-regression.mjs",
    "test:media": "cargo test --manifest-path src-tauri/Cargo.toml gstreamer_seek_reads_past_four_megabytes -- --ignored"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "cmdk": "1.1.1",
    "lucide-react": "1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@xyflow/react": "12.9.3",
    "d3": "7.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "^3.9.9",
    "typescript": "5.6.3",
    "vite": "8.0.10",
    "@types/d3": "7.4.3"
  }
}
