{
  "name": "concord",
  "productName": "Concord",
  "version": "1.0.3",
  "description": "Concord — personal research archive for spoken-word media",
  "author": "mackers",
  "homepage": "https://github.com/mackers/concord",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "set NODE_ENV=development && tsx server/index.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/index.js",
    "build:electron": "esbuild electron/main.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/electron/main.js",
    "build": "pnpm run build:client && pnpm run build:server && pnpm run build:electron",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "electron:rebuild": "electron-builder install-app-deps",
    "electron:dev": "pnpm run build && pnpm run electron:rebuild && NODE_ENV=production electron dist/electron/main.js",
    "electron:dist": "pnpm run build && electron-builder --mac --arm64",
    "electron:dist:linux": "pnpm run build && pnpm run electron:rebuild && electron-builder --linux"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-toast": "1.2.15",
    "@tanstack/react-query": "5.100.9",
    "@types/better-sqlite3": "7.6.13",
    "@xyflow/react": "12.9.3",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3": "7.9.0",
    "express": "5.2.1",
    "lucide-react": "1.14.0",
    "nanoid": "5.1.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-force-graph-2d": "1.29.1",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "wouter": "3.9.0",
    "youtube-dl-exec": "3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/linux-x64",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/linux-x64",
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller",
      "youtube-dl-exec"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.4",
    "@tailwindcss/postcss": "4.2.4",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.4",
    "@types/d3": "7.4.3",
    "@types/express": "5.0.6",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.3.0",
    "electron-builder": "26.9.0",
    "esbuild": "0.28.0",
    "postcss": "8.5.14",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "5.6.3",
    "vite": "8.0.10"
  },
  "build": {
    "appId": "com.concord.app",
    "productName": "Concord",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon-src/icon_1024.png", "to": "icon.png" }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sqlite-vec-darwin-arm64/**",
      "node_modules/sqlite-vec-linux-x64/**",
      "node_modules/@ffmpeg-installer/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "icon": "build/icon.icns",
      "identity": "Tech0001 LLC (HXKQ77VWW2)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Concord ${version}"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        { "target": "AppImage", "arch": "x64" },
        { "target": "deb", "arch": "x64" }
      ],
      "icon": "build/icons",
      "synopsis": "Personal research archive for spoken-word media",
      "description": "Concord ingests YouTube channels and local audio, transcribes and diarizes speech, embeds segments for semantic search, and lets you tag, link, and chat with the archive.",
      "maintainer": "mackers <noreply@concord.local>"
    }
  }
}
